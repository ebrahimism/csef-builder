{
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "title": "Answer",
      "type": "object"
    },
    "OwnerFact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Z]+-[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "requirement",
            "constraint",
            "decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "OwnerFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "goal": {
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "answers": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/Answer"
          }
        ]
      },
      "title": "Answers",
      "type": "object"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/OwnerFact"
      },
      "title": "Facts",
      "type": "array"
    }
  },
  "required": [
    "version",
    "sha256",
    "goal",
    "answers",
    "facts"
  ],
  "title": "ProjectRevision",
  "type": "object"
}
